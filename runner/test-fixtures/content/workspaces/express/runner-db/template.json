{
  "id": "runner-db",
  "course": "express",
  "title": "Runner test: a PostgreSQL template from SQL files, with shared dependencies",
  "image": "web",
  "storage": "host",
  "profile": "standard",
  "layout": "ide",
  "start": "run",
  "services": { "postgres": { "databases": ["dev", "test"] } },
  "ports": [{ "env": "PORT", "label": "Server" }],
  "tasks": { "serve": { "cmd": "node --env-file=.env -e \"require('node:http').createServer((q, s) => s.end(process.env.GREETING)).listen(process.env.PORT)\"", "label": "Server", "run": true } },
  "env": { "LINK": "${DATABASE_URL}" },
  "deps": { "kind": "npm", "lock": "package-lock.json", "mode": "shared" },
  "restartOnReset": true
}
