{
  "id": "playground",
  "course": "typescript",
  "title": "TypeScript playground",
  "image": "node",
  "storage": "host",
  "profile": "standard",
  "layout": "ide",
  "start": "run",
  "ports": [],
  "tasks": {
    "start": { "cmd": "npm start", "label": "Program", "run": true },
    "dev": { "cmd": "npm run dev", "label": "Watch" },
    "test": { "cmd": "npm test" },
    "check": { "cmd": "npm run check" }
  },
  "env": { "HU_FIXED_TIME": "2026-10-01T09:00:00Z" },
  "deps": { "kind": "npm", "lock": "package-lock.json", "mode": "own" },
  "open": ["README.md", "src/main.ts"],
  "hidden": [".git"],
  "panels": ["terminal", "server", "problems"],
  "diagnostics": [{ "on": "save", "cmd": ["npx", "tsc", "--noEmit", "--pretty", "false"], "parser": "tsc" }],
  "autosave": true,
  "restartOnReset": false,
  "limits": { "memoryMb": 1024, "cpus": 2, "pids": 512 }
}
