#!/bin/sh
# The main process of a workspace container (Docker's tini is PID 1). In the
# Bash course's sysadmin profile it runs as root and starts cron first, so
# learners' crontabs fire. Then it waits until the container stops.
if [ "$(id -u)" = 0 ] && command -v cron >/dev/null 2>&1; then
  cron
fi
exec /opt/hu/bin/hu-exec --idle
