# npm's global config in hu/web (/usr/local/etc/npmrc). Workspaces have no
# network (PLAN.md D5), so npm reads only the image's cache, through the
# writable view hu-npm-cache makes in /tmp, and fails at once on a package the
# cache doesn't hold instead of retrying for a minute.
cache=/tmp/npm-cache
offline=true
audit=false
fund=false
update-notifier=false
logs-dir=/tmp/npm-logs
