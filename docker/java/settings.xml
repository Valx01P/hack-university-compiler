<?xml version="1.0" encoding="UTF-8"?>
<!-- Maven's global settings in hu/java (/opt/maven/conf/settings.xml).
     Workspaces have no network (PLAN.md D5), so Maven works offline: it reads
     the image's read-only repository in /opt/hu/m2 as the tail of
     ~/.m2/repository (MAVEN_ARGS sets maven.repo.local.tail), and writes only
     to ~/.m2/repository. -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <offline>true</offline>
  <interactiveMode>false</interactiveMode>
</settings>
