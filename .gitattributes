# Line endings: LF in every checkout, Windows included. The app copies these
# files into Linux containers, where a CRLF breaks a shell script and changes
# what a program prints. A few files are about CRLF themselves, or are
# Windows scripts, so they keep their exact bytes.
* text=auto eol=lf
content/fixtures/bash/*/windows.txt -text
*.ics -text
*.cmd -text
*.bat -text
