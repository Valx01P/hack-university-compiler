{
  "id": "fastapi-playground",
  "course": "fastapi",
  "title": "FastAPI playground",
  "description": "A blank FastAPI project with its own PostgreSQL database and every package the course uses, for trying anything from the lessons.",
  "image": "python",
  "storage": "host",
  "profile": "standard",
  "layout": "ide",
  "start": "run",
  "services": {
    "postgres": { "databases": ["dev"] }
  },
  "ports": [{ "env": "PORT", "label": "API", "readyPath": "/" }],
  "tasks": {
    "dev": { "cmd": "uv run fastapi dev main.py --host 0.0.0.0 --port ${PORT:-8000}", "label": "Server", "run": true },
    "scratch": { "cmd": "uv run python scratch.py", "label": "scratch.py" },
    "test": { "cmd": "uv run pytest" }
  },
  "env": { "HU_FIXED_TIME": "2026-10-01T09:00:00Z" },
  "deps": { "kind": "uv", "lock": "uv.lock", "mode": "own" },
  "open": ["README.md", "main.py"],
  "requests": "requests.http",
  "hidden": [".git"],
  "panels": ["terminal", "server", "ports", "api", "database", "problems", "results"],
  "diagnostics": [{ "on": "save", "cmd": ["uv", "run", "--frozen", "ruff", "check", "--output-format", "concise"], "parser": "ruff" }],
  "autosave": true,
  "restartOnReset": false,
  "limits": { "memoryMb": 1024, "cpus": 2, "pids": 512 }
}
