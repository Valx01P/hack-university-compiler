{
  "version": 1,
  "image": "python",
  "db": "empty",
  "copy": { "exclude": [".venv", "__pycache__", ".pytest_cache", ".ruff_cache"], "git": false },
  "deadlineMs": 60000,
  "server": { "task": "dev", "port": "PORT", "ready": { "path": "/", "timeoutMs": 20000 } },
  "steps": [
    { "id": "lock", "kind": "cmd", "run": ["uv", "lock", "--check", "--offline"], "expect": { "exit": 0 } },
    {
      "id": "lint",
      "kind": "cmd",
      "run": ["uv", "run", "--frozen", "--offline", "ruff", "check", "--output-format", "concise"],
      "expect": { "exit": 0 },
      "parse": "ruff"
    },
    { "id": "tests", "kind": "unit", "tool": "pytest", "run": ["test_main.py"] },
    {
      "id": "scratch",
      "kind": "cmd",
      "run": ["uv", "run", "--frozen", "--offline", "python", "scratch.py"],
      "expect": { "exit": 0, "stdoutRegex": "^PostgreSQL 18\\.6 " }
    },
    { "id": "api", "kind": "http-file", "file": "requests.http" }
  ],
  "acceptance": {
    "lock": "uv.lock matches pyproject.toml",
    "lint": "Ruff reports nothing",
    "tests": "test_main.py passes",
    "scratch": "scratch.py reaches the workspace's PostgreSQL 18.6 database",
    "api": "The running server answers GET / as requests.http says"
  }
}
