# Every setting Taskboard reads, with what it is for. Copy this file to .env and fill it in.
# Real environment variables win over .env.

# development, test, or production. Production hides /docs, /redoc, and /openapi.json.
ENVIRONMENT=development

# SQLAlchemy URLs with the psycopg 3 driver. The test database's name must end in "test".
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/taskboard
TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/taskboard_test

# Connection pool size per process, and how many extra connections a burst may open.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# At least 32 characters. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-64-random-hex-characters-0000000000000000

# How long an access token lasts, in minutes (the contract says 24 hours).
ACCESS_TOKEN_MINUTES=1440

# Browser origins allowed to call the API with credentials: a JSON list or comma-separated.
# ${WEB_PORT:-5173} is filled in from the environment when the file is read.
CORS_ORIGINS=http://localhost:${WEB_PORT:-5173}

# A fixed time for the clock, such as 2026-10-01T09:00:00Z. Leave it empty in production.
HU_FIXED_TIME=

# At least 16 characters, checked by internal endpoints in the X-Internal-Key header.
INTERNAL_API_KEY=change-me-to-a-long-random-key

# Where the fake mailer writes, one line per mail.
MAIL_LOG=var/mail.log

# Page sizes for lists: the default, and the most a client may ask for.
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
