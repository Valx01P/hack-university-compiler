{
  // Stockroom's type-checking settings. "extends" takes shared bases, and later entries win:
  // @tsconfig/node26 sets Node 26's module system, target, and lib and loads Node's types,
  // and @tsconfig/strictest turns on every strictness flag. Run `npx tsc --showConfig` to
  // see the merged result.
  "extends": ["@tsconfig/node26/tsconfig.json", "@tsconfig/strictest/tsconfig.json"],
  "compilerOptions": {
    // The options that make this a project Node runs directly. No base sets them, so they
    // stay here, where you can see them.
    // tsc only checks, because Node runs the .ts files itself.
    "noEmit": true,
    // Imports name the real file (./item.ts), which is the file Node loads.
    "allowImportingTsExtensions": true,
    // Only syntax Node can strip: no enum, no parameter properties, no namespaces with code.
    "erasableSyntaxOnly": true,
    // A type-only import must say so, because Node keeps every other import.
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noUncheckedSideEffectImports": true
  },
  "include": ["src", "test", "type-tests"]
}
