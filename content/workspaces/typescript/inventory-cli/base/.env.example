# Stockroom's settings. .env is your copy of this file: `npm run cli` and `npm run dev` read
# it (node --env-file=.env), and real environment variables win over what it says.

# The inventory file. A relative path starts from the folder you run the command in, and
# the default is data/inventory.json in this project, wherever you run it from.
STOCKROOM_DATA=data/inventory.json

# Items at or below this quantity count as low stock (list --low).
STOCKROOM_LOW_STOCK=5

# Freezes the clock at this ISO time, so the updatedAt stamps are predictable. Empty means
# the real time. Hack University sets 2026-10-01T09:00:00Z for you.
HU_FIXED_TIME=
