{
  "id": "inventory-cli",
  "course": "typescript",
  "title": "Stockroom (inventory CLI)",
  "image": "node",
  "storage": "host",
  "profile": "standard",
  "layout": "ide",
  "start": "run",
  "ports": [],
  "tasks": {
    "dev": { "cmd": "npm run dev", "label": "Watch list", "run": true },
    "test": { "cmd": "npm test" },
    "check": { "cmd": "npm run check" },
    "seed": { "cmd": "npm run data:reset" }
  },
  "env": { "HU_FIXED_TIME": "2026-10-01T09:00:00Z" },
  "deps": { "kind": "npm", "lock": "package-lock.json", "mode": "shared" },
  "open": ["README.md", "src/cli.ts"],
  "readonly": ["README.md"],
  "hidden": [".git"],
  "panels": ["terminal", "server", "problems", "results"],
  "diagnostics": [{ "on": "save", "cmd": ["npx", "tsc", "--noEmit", "--pretty", "false"], "parser": "tsc" }],
  "autosave": true,
  "restartOnReset": true,
  "limits": { "memoryMb": 1024, "cpus": 2, "pids": 512 }
}
