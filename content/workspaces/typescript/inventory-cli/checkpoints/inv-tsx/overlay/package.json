{
  "name": "stockroom",
  "version": "1.4.0",
  "description": "Stockroom: the command-line tool a small shop uses to keep track of its stock.",
  "private": true,
  "type": "module",
  "imports": {
    "#commands/*": "./src/commands/*",
    "#domain/*": "./src/domain/*",
    "#format/*": "./src/format/*",
    "#storage/*": "./src/storage/*"
  },
  "scripts": {
    "cli": "tsx src/cli.ts",
    "dev": "tsx watch src/cli.ts list",
    "typecheck": "tsc",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm test",
    "data:reset": "cp fixtures/seed.json data/inventory.json"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tsconfig/node26": "26.0.1",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "26.6.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.13.0",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.0"
  }
}
