{
  // The course's settings: TypeScript 7 only checks (noEmit), and Node 26 runs the .ts files
  // directly by stripping the types, so there is no build step.
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    // Node's types are opt-in since TypeScript 7 made "types" default to [].
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    // Only syntax Node can strip: no enum, no parameter properties, no namespaces with code.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noUncheckedSideEffectImports": true,
    // Imports name the real file (./http.ts), which is the file Node loads.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src", "mock-api", "examples", "test", "type-tests"]
}
