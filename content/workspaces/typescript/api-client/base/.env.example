# The demo's settings. .env is your copy of this file, and npm run demo reads it
# (node --env-file=.env). Real environment variables win over what it says.

# The key the mock accepts. A real Parcelly key would never be committed.
PARCELLY_API_KEY=test_key_123

# Where Parcelly lives. Empty means the local mock: http://localhost:$MOCK_PORT, the port the
# workspace gives it (4010 outside Hack University).
PARCELLY_BASE_URL=
