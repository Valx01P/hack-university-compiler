{
  "name": "@hu/parcelly",
  "version": "1.6.0",
  "description": "A typed TypeScript SDK for the Parcelly parcel-tracking API, with a local mock of the API to run it against.",
  "private": true,
  "type": "module",
  "scripts": {
    "mock": "node --watch mock-api/server.ts",
    "demo": "node --env-file=.env examples/track.ts",
    "dev": "node --watch --env-file=.env examples/track.ts SHP-1001",
    "typecheck": "tsc",
    "test": "node --test \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  }
}
