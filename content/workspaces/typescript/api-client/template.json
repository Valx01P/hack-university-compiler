{
  "id": "api-client",
  "course": "typescript",
  "title": "Parcelly SDK",
  "image": "node",
  "storage": "host",
  "profile": "standard",
  "layout": "ide",
  "start": "run",
  "ports": [{ "env": "MOCK_PORT", "label": "Parcelly mock", "readyPath": "/health" }],
  "tasks": {
    "mock": { "cmd": "npm run mock", "label": "Parcelly mock", "run": true },
    "dev": { "cmd": "npm run dev", "label": "Demo (watch)" },
    "test": { "cmd": "npm test" },
    "check": { "cmd": "npm run check" }
  },
  "env": { "HU_FIXED_TIME": "2026-10-01T09:00:00Z" },
  "deps": { "kind": "npm", "lock": "package-lock.json", "mode": "shared" },
  "open": ["README.md", "src/client.ts"],
  "requests": "requests.http",
  "readonly": ["README.md", "openapi.yaml"],
  "hidden": [".git"],
  "panels": ["terminal", "server", "ports", "api", "problems", "results"],
  "diagnostics": [{ "on": "save", "cmd": ["npx", "tsc", "--noEmit", "--pretty", "false"], "parser": "tsc" }],
  "autosave": true,
  "restartOnReset": true,
  "limits": { "memoryMb": 1024, "cpus": 2, "pids": 512 }
}
