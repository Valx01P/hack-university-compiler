{
  "id": "orders-service",
  "course": "typescript",
  "title": "Bramble Coffee orders API",
  "description": "The order service of a small coffee roaster: an HTTP API with layered controllers, services, and repositories on SQLite.",
  "image": "node",
  "storage": "host",
  "profile": "standard",
  "layout": "ide",
  "start": "run",
  "ports": [{ "env": "PORT", "label": "API", "readyPath": "/health" }],
  "tasks": {
    "dev": { "cmd": "npm run dev", "label": "Server (watch)", "run": true },
    "start": { "cmd": "npm start", "label": "Server" },
    "test": { "cmd": "npm test" },
    "check": { "cmd": "npm run check" },
    "seed": { "cmd": "npm run db:reset" }
  },
  "env": { "HU_FIXED_TIME": "2026-10-01T09:00:00Z" },
  "deps": { "kind": "npm", "lock": "package-lock.json", "mode": "shared" },
  "open": ["README.md", "src/app.ts"],
  "requests": "requests.http",
  "readonly": ["README.md"],
  "hidden": [".git"],
  "panels": ["terminal", "server", "ports", "api", "problems", "results"],
  "diagnostics": [{ "on": "save", "cmd": ["npx", "tsc", "--noEmit", "--pretty", "false"], "parser": "tsc" }],
  "autosave": true,
  "restartOnReset": true,
  "limits": { "memoryMb": 1024, "cpus": 2, "pids": 512 }
}
