# The order service's settings. .env is your copy of this file: npm run dev, start, db:reset,
# and db:query read it (node --env-file=.env), and real environment variables win over it.
# PORT comes from the workspace (the server prints it), so it is not set here.

# The SQLite file. npm run db:reset rebuilds it from db/migrations and db/seed.sql.
DATABASE_PATH=data/bramble.db

# debug, info, warn, or error.
LOG_LEVEL=info

# Staff and customer API keys, as name:key pairs separated by commas (used by a challenge).
API_KEYS=

# Freezes the clock at this ISO time. Empty means the real time. Hack University sets
# 2026-10-01T09:00:00Z, so new orders, payments, and log lines have predictable times.
HU_FIXED_TIME=
