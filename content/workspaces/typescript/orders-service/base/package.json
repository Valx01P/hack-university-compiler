{
  "name": "bramble-orders",
  "version": "2.3.0",
  "description": "Bramble Coffee's order service: a layered HTTP API on node:http and SQLite.",
  "private": true,
  "type": "module",
  "imports": {
    "#domain/*": "./src/domain/*",
    "#http/*": "./src/http/*",
    "#repositories/*": "./src/repositories/*",
    "#schemas/*": "./src/schemas/*",
    "#services/*": "./src/services/*"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.ts",
    "start": "node --env-file=.env src/server.ts",
    "typecheck": "tsc",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:unit": "node --test \"test/unit/**/*.test.ts\"",
    "test:http": "node --test \"test/http/**/*.test.ts\"",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test",
    "db:reset": "node --env-file=.env scripts/db-reset.ts",
    "db:query": "node --env-file=.env scripts/db-query.ts"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.13.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.0"
  }
}
