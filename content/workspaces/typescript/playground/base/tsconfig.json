{
  // The course's settings, the same ones the single-file lessons use. TypeScript 7 only
  // checks the code (noEmit), and Node 26 runs the .ts files itself by stripping the types.
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    // Node's types are opt-in since TypeScript 7 made "types" default to [].
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    // Only syntax Node can strip: no enum, no parameter properties, no namespaces with code.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noUncheckedSideEffectImports": true,
    // Imports name the real file (./greet.ts), which is what Node loads.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src", "test"]
}
