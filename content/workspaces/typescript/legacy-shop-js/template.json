{
  "id": "legacy-shop-js",
  "course": "typescript",
  "title": "Corner Shop (legacy JavaScript)",
  "image": "node",
  "storage": "host",
  "profile": "standard",
  "layout": "ide",
  "start": "run",
  "ports": [{ "env": "PORT", "label": "Shop", "readyPath": "/products" }],
  "tasks": {
    "start": { "cmd": "npm start", "label": "Server", "run": true },
    "dev": { "cmd": "npm run dev", "label": "Server (watch)" },
    "test": { "cmd": "npm test" }
  },
  "env": { "HU_FIXED_TIME": "2026-10-01T09:00:00Z" },
  "deps": { "kind": "npm", "lock": "package-lock.json", "mode": "shared" },
  "open": ["README.md"],
  "requests": "requests.http",
  "hidden": [".git"],
  "panels": ["terminal", "server", "ports", "api", "problems", "results"],
  "diagnostics": [{ "on": "save", "cmd": ["npx", "tsc", "--noEmit", "--pretty", "false"], "parser": "tsc", "requires": ["tsconfig.json"] }],
  "autosave": true,
  "restartOnReset": true,
  "limits": { "memoryMb": 1024, "cpus": 2, "pids": 512 }
}
