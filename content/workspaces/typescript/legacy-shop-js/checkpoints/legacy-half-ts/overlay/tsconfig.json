{
  // Half JavaScript, half TypeScript. allowJs and checkJs keep checking the .js files through
  // their JSDoc, and allowImportingTsExtensions lets a .js file import a .ts one by its real
  // name (./lib/tax.ts), which Node runs directly. strict stays off until every file is .ts.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": false,
    "module": "nodenext",
    "target": "esnext",
    "types": ["node"],
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["server.js", "lib", "test"]
}
