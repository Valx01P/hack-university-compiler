{
  // Type-checks the JavaScript as it is. allowJs and checkJs make tsc read the .js files,
  // and JSDoc comments (/** @param {number} qty */) give it the types. strict stays off for
  // now, so only plain mistakes show up, such as a misspelled property.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "module": "nodenext",
    "target": "esnext",
    "types": ["node"],
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["server.js", "lib", "test"]
}
