{
  "id": "quickcart-legacy",
  "course": "express",
  "title": "QuickCart (legacy)",
  "image": "web",
  "storage": "host",
  "profile": "standard",
  "layout": "ide",
  "start": "run",
  "services": {
    "postgres": { "build": ["npm", "run", "db:reset"], "databases": ["dev"] }
  },
  "ports": [{ "env": "PORT", "label": "API", "readyPath": "/health" }],
  "tasks": {
    "dev": { "cmd": "npm run dev", "label": "Server", "run": true },
    "start": { "cmd": "npm start", "label": "Server" },
    "test": { "cmd": "npm test" },
    "seed": { "cmd": "npm run db:reset" }
  },
  "env": { "HU_FIXED_TIME": "2026-10-01T09:00:00Z" },
  "deps": { "kind": "npm", "lock": "package-lock.json", "mode": "shared" },
  "open": ["README.md", "app.js", "requests.http"],
  "requests": "requests.http",
  "hidden": [".git"],
  "panels": ["terminal", "server", "ports", "api", "database", "results"],
  "autosave": true,
  "restartOnReset": true,
  "limits": { "memoryMb": 1024, "cpus": 2, "pids": 512 }
}
