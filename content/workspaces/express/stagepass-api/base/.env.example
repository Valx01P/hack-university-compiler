# StagePass settings. Copy this file to .env for anything you want to change: npm run dev, start,
# and the scripts read it (node --env-file-if-exists=.env), and real environment variables win.
# In Hack University the workspace already sets PORT, DATABASE_URL, TEST_DATABASE_URL, NODE_ENV,
# and HU_FIXED_TIME, so .env is optional. src/config.ts checks every value at startup.

# The port to listen on. The workspace picks a free one, the same number inside and out.
PORT=3000
# Listen on every interface, so the port is reachable from outside the container.
HOST=0.0.0.0

# development, test, or production. Production requires JWT_SECRET and turns off X-Query-Count.
NODE_ENV=development
# fatal, error, warn, info, debug, trace, or silent.
LOG_LEVEL=info

# PostgreSQL for the app, and a separate one that the int tests empty and refill.
DATABASE_URL=postgres://stagepass:stagepass@localhost:5432/stagepass
TEST_DATABASE_URL=postgres://stagepass:stagepass@localhost:5432/stagepass_test
# PostgreSQL cancels any single statement that runs longer than this.
DB_STATEMENT_TIMEOUT_MS=15000
# true applies pending migrations when the server starts (handy locally, a release step in production).
MIGRATE_ON_START=false

# Access tokens: HS256 JWTs. At least 32 random characters, for example: openssl rand -base64 48
# Development and tests fall back to a fixed, public secret when this is empty.
JWT_SECRET=
JWT_ISSUER=stagepass
ACCESS_TOKEN_TTL_SECONDS=900
# A login's refresh tokens stop working this many days after it, however often they rotate.
REFRESH_TOKEN_TTL_DAYS=30

# Browser apps on other origins that may call the API, comma-separated, exact: http://localhost:5173
CORS_ORIGINS=
# Requests per minute per address on /v1. 0 turns this limit off, for load tests (npm run bench).
# Logins and signups keep their own limit: 5 per 15 minutes per address and email.
API_RATE_LIMIT_PER_MINUTE=300
# Behind a proxy or load balancer, how many hops to trust for X-Forwarded-For: false, true, or a number.
TRUST_PROXY=false
# Where uploaded posters are stored (in posters/ inside it). Never under public/.
UPLOAD_DIR=uploads

# Graceful shutdown: how long /readyz answers 503 before the server stops accepting connections,
# and how long requests in flight may take after that before their connections are closed.
SHUTDOWN_DELAY_MS=0
SHUTDOWN_TIMEOUT_MS=10000
# Longer than the load balancer's idle timeout (often 60 s).
KEEP_ALIVE_TIMEOUT_MS=65000

# Hack University only. HU_FIXED_TIME freezes the clock (2026-10-01T09:00:00Z), so new orders and
# tokens look the same on every run. HU_RACE_DELAY_MS pauses between a read and a write in checkout,
# for the concurrency lessons. HU_PREVIEW_PARENT is the origin allowed to frame the pages in development.
HU_FIXED_TIME=
HU_RACE_DELAY_MS=0
HU_PREVIEW_PARENT=
