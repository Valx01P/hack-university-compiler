{
  "name": "stagepass-api",
  "version": "1.4.0",
  "description": "StagePass: a ticketing API for small venues, on Express 5, Drizzle, and PostgreSQL.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.12.0"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "dev:pretty": "node --watch --env-file-if-exists=.env src/server.ts | pino-pretty",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "test": "vitest run --configLoader native",
    "test:unit": "vitest run --configLoader native --project unit",
    "test:api": "vitest run --configLoader native --project api",
    "test:int": "vitest run --configLoader native --project int",
    "test:watch": "vitest --configLoader native",
    "typecheck": "tsc --noEmit",
    "ci": "npm run typecheck && npm test && npm run db:check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.ts",
    "db:reset": "node --env-file-if-exists=.env scripts/db-reset.ts",
    "db:build": "npm run db:migrate && npm run db:seed",
    "db:build:perf": "npm run db:build && psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -q -f scripts/seed-perf.sql",
    "openapi": "node --env-file-if-exists=.env scripts/openapi.ts",
    "bench": "sh scripts/bench.sh",
    "race": "node --env-file-if-exists=.env scripts/race.ts"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "drizzle-orm": "0.45.4",
    "ejs": "7.0.2",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "multer": "2.4.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "autocannon": "8.0.0",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
