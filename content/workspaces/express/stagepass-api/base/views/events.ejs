<%- include("partials/head", { title }) %>
<h1>Upcoming events</h1>
<% if (events.length === 0) { %>
  <p class="empty">No upcoming events. Check back soon.</p>
<% } else { %>
  <%# A grid of cards that becomes one column on narrow screens (see site.css). %>
  <ul class="event-grid">
    <% for (const event of events) { %>
      <li class="event-card">
        <a href="/e/<%= event.slug %>">
          <img src="<%= event.poster %>" alt="" width="300" height="420" loading="lazy">
          <span class="category"><%= event.category %></span>
          <h2><%= event.title %></h2>
          <p class="when"><%= event.date %></p>
          <p class="where"><%= event.place %></p>
          <% if (event.from !== null) { %>
            <p class="price">From <%= event.from %></p>
          <% } %>
        </a>
      </li>
    <% } %>
  </ul>
<% } %>
<%- include("partials/foot") %>
