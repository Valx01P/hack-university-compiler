<%- include("partials/head", { title }) %>
<article class="event-page">
  <img class="poster" src="<%= event.poster %>" alt="Poster for <%= event.title %>" width="300" height="420">
  <div class="details">
    <span class="category"><%= event.category %></span>
    <h1><%= event.title %></h1>
    <% if (event.cancelled) { %>
      <p class="banner">This event was cancelled. Every order was cancelled with it.</p>
    <% } %>
    <p class="when"><%= event.date %></p>
    <p class="where"><%= event.venue %>, <%= event.address %></p>
    <p class="description"><%= event.description %></p>
    <h2>Tickets</h2>
    <% if (event.tickets.length === 0) { %>
      <p class="empty">Tickets are not on sale yet.</p>
    <% } else { %>
      <ul class="tickets">
        <% for (const ticket of event.tickets) { %>
          <li>
            <span class="name"><%= ticket.name %></span>
            <span class="price"><%= ticket.price %></span>
            <% if (ticket.soldOut) { %><span class="badge">Sold out</span><% } %>
          </li>
        <% } %>
      </ul>
    <% } %>
    <p><a href="<%= event.calendarUrl %>">Add to calendar</a></p>
  </div>
</article>
<%- include("partials/foot") %>
