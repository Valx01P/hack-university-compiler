{
  "id": "stagepass-api",
  "course": "express",
  "title": "StagePass API",
  "description": "A ticketing API for small venues, written the way a current Node team writes one: feature modules with routes, controllers, services, and repositories on PostgreSQL with Drizzle.",
  "image": "web",
  "storage": "host",
  "profile": "standard",
  "layout": "ide",
  "start": "run",
  "services": {
    "postgres": {
      "build": ["npm", "run", "db:build"],
      "databases": ["dev", "test"],
      "env": { "dev": "DATABASE_URL", "test": "TEST_DATABASE_URL" },
      "testBuild": ["npm", "run", "db:migrate"],
      "variants": {
        "perf": { "build": ["npm", "run", "db:build:perf"], "budgetMs": 30000 }
      }
    }
  },
  "ports": [{ "env": "PORT", "label": "API", "readyPath": "/healthz" }],
  "tasks": {
    "dev": { "cmd": "npm run dev", "label": "Server", "run": true },
    "start": { "cmd": "npm start", "label": "Server" },
    "test": { "cmd": "npm test" },
    "typecheck": { "cmd": "npm run typecheck" },
    "migrate": { "cmd": "npm run db:migrate" },
    "seed": { "cmd": "npm run db:seed" },
    "reset": { "cmd": "npm run db:reset" }
  },
  "env": {
    "NODE_ENV": "development",
    "HU_FIXED_TIME": "2026-10-01T09:00:00Z",
    "LOG_LEVEL": "info"
  },
  "deps": { "kind": "npm", "lock": "package-lock.json", "mode": "shared" },
  "build": [".vite-cache"],
  "open": ["README.md", "src/app.ts"],
  "requests": "requests.http",
  "readonly": ["README.md"],
  "hidden": [".git"],
  "panels": ["terminal", "server", "ports", "api", "database", "problems", "results"],
  "diagnostics": [{ "on": "save", "cmd": ["npx", "tsc", "--noEmit", "--pretty", "false"], "parser": "tsc" }],
  "autosave": true,
  "restartOnReset": true,
  "limits": { "memoryMb": 1024, "cpus": 2, "pids": 512 }
}
