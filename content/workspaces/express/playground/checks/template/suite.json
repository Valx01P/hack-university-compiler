{
  "version": 1,
  "image": "web",
  "db": "none",
  "copy": { "exclude": ["node_modules"], "git": false },
  "deadlineMs": 60000,
  "server": { "task": "start", "port": "PORT", "ready": { "path": "/hello", "timeoutMs": 10000 } },
  "steps": [
    { "id": "typecheck", "kind": "cmd", "run": ["npx", "tsc", "--noEmit", "--pretty", "false"], "expect": { "exit": 0 }, "parse": "tsc" },
    { "id": "tests", "kind": "cmd", "run": ["npm", "test"], "expect": { "exit": 0 } },
    { "id": "scratch", "kind": "cmd", "run": ["node", "src/scratch.ts"], "expect": { "exit": 0, "stdout": "" } },
    { "id": "api", "kind": "http-file", "file": "requests.http" }
  ],
  "acceptance": {
    "typecheck": "The project type-checks",
    "tests": "npm test runs (and passes with no tests yet)",
    "scratch": "The scratch file runs",
    "api": "GET /hello answers as requests.http states"
  }
}
