{
  "name": "express-playground",
  "version": "1.0.0",
  "description": "Free play for the Node, Express and databases course: every course package is installed.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.12.0"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "bcryptjs": "3.0.3",
    "connect-mongo": "6.0.0",
    "connect-pg-simple": "10.0.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "drizzle-orm": "0.45.4",
    "ejs": "7.0.2",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "express-session": "1.19.0",
    "express4": "npm:express@4.22.3",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "jsonwebtoken": "9.0.3",
    "mongodb": "7.7.0",
    "mongoose": "9.11.2",
    "multer": "2.4.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "7.0.3",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "autocannon": "8.0.0",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
