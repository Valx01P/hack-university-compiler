{
  // The course's settings. Node 26 runs the .ts files by stripping their types, so tsc only
  // checks (noEmit) and there is no build step.
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "types": ["node"],
    "strict": true,
    // Only syntax Node can strip: no enum, no parameter properties, no namespaces with code.
    "erasableSyntaxOnly": true,
    // A type-only import must say so, because Node keeps every other import.
    "verbatimModuleSyntax": true,
    // Imports name the real file (./money.ts), which is the file Node loads.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src", "test"]
}
