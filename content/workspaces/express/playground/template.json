{
  "id": "playground",
  "course": "express",
  "title": "Express playground",
  "description": "Free play for Node and Express, with every package the course uses installed and PostgreSQL and MongoDB ready to use.",
  "image": "web",
  "storage": "host",
  "profile": "standard",
  "layout": "ide",
  "start": "run",
  "services": {
    "postgres": { "databases": ["dev"], "env": { "dev": "DATABASE_URL" } },
    "mongo": { "databases": ["dev"], "env": { "dev": "MONGODB_URI" } }
  },
  "ports": [{ "env": "PORT", "label": "Server", "readyPath": "/hello" }],
  "tasks": {
    "dev": { "cmd": "npm run dev", "label": "Server", "run": true },
    "start": { "cmd": "npm start", "label": "Server" },
    "test": { "cmd": "npm test" },
    "typecheck": { "cmd": "npm run typecheck" }
  },
  "env": { "NODE_ENV": "development" },
  "deps": { "kind": "npm", "lock": "package-lock.json", "mode": "own" },
  "open": ["README.md", "src/server.ts"],
  "requests": "requests.http",
  "hidden": [".git"],
  "panels": ["terminal", "server", "ports", "api", "database", "problems"],
  "diagnostics": [{ "on": "save", "cmd": ["npx", "tsc", "--noEmit", "--pretty", "false"], "parser": "tsc" }],
  "autosave": true,
  "restartOnReset": false,
  "limits": { "memoryMb": 1024, "cpus": 2, "pids": 512 }
}
