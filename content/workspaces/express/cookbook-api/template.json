{
  "id": "cookbook-api",
  "course": "express",
  "title": "Cookbook API",
  "image": "web",
  "storage": "host",
  "profile": "standard",
  "layout": "ide",
  "start": "run",
  "services": {
    "mongo": { "build": ["npm", "run", "db:reset"], "databases": ["dev", "test"], "replicaSet": "rs0" }
  },
  "ports": [{ "env": "PORT", "label": "API", "readyPath": "/health" }],
  "tasks": {
    "dev": { "cmd": "npm run dev", "label": "Server", "run": true },
    "start": { "cmd": "npm start", "label": "Server" },
    "test": { "cmd": "npm test" },
    "seed": { "cmd": "npm run db:reset" }
  },
  "env": { "NODE_ENV": "development", "HU_FIXED_TIME": "2026-10-01T09:00:00Z" },
  "deps": { "kind": "npm", "lock": "package-lock.json", "mode": "shared" },
  "open": ["README.md", "src/models/recipe.model.ts", "requests.http"],
  "requests": "requests.http",
  "readonly": ["README.md"],
  "hidden": [".git"],
  "panels": ["terminal", "server", "ports", "api", "database", "problems", "results"],
  "diagnostics": [{ "on": "save", "cmd": ["npx", "tsc", "--noEmit", "--pretty", "false"], "parser": "tsc" }],
  "autosave": true,
  "restartOnReset": true,
  "limits": { "memoryMb": 1024, "cpus": 2, "pids": 512 }
}
