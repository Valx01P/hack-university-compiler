{
  "version": 1,
  "image": "web",
  "db": "clone",
  "copy": { "exclude": ["node_modules"], "git": false },
  "deadlineMs": 90000,
  "server": { "task": "start", "port": "PORT", "ready": { "path": "/health", "timeoutMs": 20000 } },
  "steps": [
    { "id": "typecheck", "kind": "cmd", "run": ["npx", "tsc", "--noEmit", "--pretty", "false"], "expect": { "exit": 0 }, "parse": "tsc" },
    { "id": "tests", "kind": "unit", "tool": "vitest", "files": ["test/**/*.test.ts"] },
    { "id": "api", "kind": "http-file", "file": "requests.http" }
  ],
  "acceptance": {
    "typecheck": "The project type-checks",
    "tests": "The model and API tests pass against a real MongoDB replica set",
    "api": "Every request in requests.http gets the status and body it states"
  }
}
