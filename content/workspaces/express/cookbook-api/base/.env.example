# Cookbook's settings. Copy this to .env for local runs; the workspace sets the real values.
# Real environment variables always win over .env.

# The server listens on PORT (the workspace leases it and the server prints the address).
PORT=3000

# The MongoDB connection string. The workspace points this at its own database on the shared
# one-node replica set, so multi-document transactions work (they need a replica set).
MONGODB_URI=mongodb://127.0.0.1:27017/cookbook?replicaSet=rs0

# A separate database for the test suite. Each test file uses a database derived from this.
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/cookbook_test?replicaSet=rs0

# Signs the session cookie. Any non-empty string in development.
SESSION_SECRET=cookbook-dev-secret

# The session cookie's name. Unique per workspace so two workspaces on localhost do not clash.
SESSION_COOKIE_NAME=cookbook.sid

# debug, info, warn, or error.
LOG_LEVEL=info

# Freezes the clock at this ISO time. Empty means the real time. The workspace sets
# 2026-10-01T09:00:00Z, so timestamps on new documents and log lines are predictable.
HU_FIXED_TIME=
