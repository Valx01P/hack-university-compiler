{
  "name": "cookbook-api",
  "version": "1.0.0",
  "description": "Cookbook: a recipes and reviews API in classic Express MVC on MongoDB with Mongoose.",
  "private": true,
  "type": "module",
  "engines": { "node": ">=26.12.0" },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.ts",
    "db:indexes": "node --env-file-if-exists=.env scripts/sync-indexes.ts",
    "db:reset": "node --env-file-if-exists=.env scripts/seed.ts && node --env-file-if-exists=.env scripts/sync-indexes.ts"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "connect-mongo": "6.0.0",
    "express": "5.3.0",
    "express-session": "1.19.0",
    "mongoose": "9.11.2",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/node": "26.6.5",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.1",
    "@types/supertest": "7.2.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
