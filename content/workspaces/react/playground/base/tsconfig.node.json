{
  // Files that run in Node outside the app: the Vite config, the dev script, and Playwright files
  // if you add them (playwright.config.ts and e2e/). DOM is there for the callbacks a spec passes
  // to page.evaluate(), which run in the browser.
  "compilerOptions": {
    "tsBuildInfoFile": "./.vite/tsc/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.ts", "playwright.config.ts", "scripts", "e2e"]
}
