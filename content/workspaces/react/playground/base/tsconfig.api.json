{
  // The mock API. Node runs these files directly by stripping their types, so they use only
  // erasable syntax (no enums, namespaces, or parameter properties) and import with .ts extensions.
  "compilerOptions": {
    "tsBuildInfoFile": "./.vite/tsc/tsconfig.api.tsbuildinfo",
    "target": "es2024",
    "lib": ["ES2024"],
    "types": ["node"],
    "skipLibCheck": true,
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["api"]
}
