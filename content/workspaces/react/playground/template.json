{
  "id": "playground",
  "course": "react",
  "title": "React playground",
  "image": "web",
  "storage": "host",
  "profile": "standard",
  "layout": "ide",
  "start": "run",
  "ports": [
    { "env": "WEB_PORT", "label": "Web", "readyPath": "/", "preview": true },
    { "env": "API_PORT", "label": "API", "readyPath": "/healthz" }
  ],
  "tasks": {
    "dev": { "cmd": "npm run dev", "label": "Web and API", "run": true },
    "dev:web": { "cmd": "npm run dev:web", "label": "Web only" },
    "dev:api": { "cmd": "npm run dev:api", "label": "API only" },
    "test": { "cmd": "npm test", "label": "Tests (watch)" },
    "test:run": { "cmd": "npm run test:run", "label": "Tests" },
    "typecheck": { "cmd": "npm run typecheck" },
    "lint": { "cmd": "npm run lint" },
    "build": { "cmd": "npm run build" },
    "preview": { "cmd": "npm run preview", "label": "Production build on 4173" },
    "seed": { "cmd": "npm run api:reset", "label": "Reset data" }
  },
  "env": { "TZ": "UTC", "HU_FIXED_TIME": "2026-10-01T09:00:00Z" },
  "deps": { "kind": "npm", "lock": "package-lock.json", "mode": "own" },
  "build": [".vite", "dist"],
  "open": ["src/App.tsx", "README.md"],
  "requests": "requests.http",
  "hidden": [".git"],
  "panels": ["terminal", "server", "ports", "preview", "api", "tests", "problems"],
  "diagnostics": [
    { "on": "save", "cmd": ["npx", "tsc", "-b", "--pretty", "false"], "parser": "tsc" },
    { "on": "save", "cmd": ["npx", "oxlint", "--format", "unix"], "parser": "eslint" }
  ],
  "autosave": true,
  "restartOnReset": true,
  "limits": { "memoryMb": 1536, "cpus": 2, "pids": 512 }
}
