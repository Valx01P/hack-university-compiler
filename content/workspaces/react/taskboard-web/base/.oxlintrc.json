{
  // oxlint runs with npm run lint, after every save in the Problems panel, and in checks.
  // The hooks and React Compiler rules are errors because breaking them breaks the app.
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "ignorePatterns": ["dist", ".vite", "playwright-report", "test-results"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/jsx-key": "error",
    "react/set-state-in-effect": "error",
    "react/no-deriving-state-in-effects": "error",
    "react/purity": "error",
    "react/refs": "error",
    "react/immutability": "error",
    "react/no-danger": "error",
    "react/no-array-index-key": "warn",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    // A feature's components and hooks are private: other code imports the feature's index.ts.
    // Inside a feature, files import each other with relative paths, so this never stops them.
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@/features/*/components/*", "@/features/*/hooks/*"],
            "message": "Import from the feature's index.ts, its public API."
          }
        ]
      }
    ]
  }
}
