{
  "name": "taskboard-web",
  "private": true,
  "version": "1.0.0",
  "description": "The web client of Taskboard, a team task tracker, with a local mock of the Taskboard API.",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:web": "vite --configLoader native",
    "dev:api": "node --watch api/server.ts",
    "build": "tsc -b && vite build --configLoader native",
    "preview": "vite preview --configLoader native",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest --configLoader native",
    "test:run": "vitest run --configLoader native",
    "e2e": "playwright test",
    "api:reset": "node api/reset.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.4",
    "@tanstack/react-query-devtools": "5.104.4",
    "clsx": "2.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-error-boundary": "6.1.6",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@playwright/test": "1.64.1",
    "@rolldown/plugin-babel": "0.2.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "express": "5.3.0",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "oxlint": "1.88.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
