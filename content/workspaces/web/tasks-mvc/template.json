{
  "id": "tasks-mvc",
  "course": "web",
  "title": "Tasks app in MVC",
  "description": "A to-do app in plain JavaScript split the MVC way: a Model that owns the data, Views that draw it, and a Controller that connects them, saved in localStorage.",
  "image": "check-web",
  "storage": "host",
  "profile": "standard",
  "layout": "ide",
  "start": "run",
  "ports": [{ "env": "PORT", "label": "App", "readyPath": "/", "preview": true }],
  "tasks": {
    "dev": { "cmd": "npm run dev", "label": "Dev server", "run": true },
    "test": { "cmd": "npm test" },
    "e2e": { "cmd": "npm run e2e" },
    "build": { "cmd": "npm run build" },
    "preview": { "cmd": "npm run preview", "label": "Built app" }
  },
  "env": { "HU_FIXED_TIME": "2026-10-01T09:00:00Z" },
  "deps": { "kind": "npm", "lock": "package-lock.json", "mode": "shared" },
  "build": [".vite-cache", "dist"],
  "open": ["README.md", "src/main.js"],
  "readonly": ["README.md"],
  "hidden": [".git"],
  "panels": ["terminal", "server", "ports", "problems", "results"],
  "diagnostics": [],
  "autosave": true,
  "restartOnReset": false,
  "limits": { "memoryMb": 1536, "cpus": 2, "pids": 512 }
}
