{
  "id": "web-playground",
  "course": "web",
  "title": "Web playground",
  "image": "check-web",
  "storage": "host",
  "profile": "standard",
  "layout": "ide",
  "start": "run",
  "ports": [{ "env": "PORT", "label": "Page", "readyPath": "/", "preview": true }],
  "tasks": {
    "dev": { "cmd": "npm run dev", "label": "Dev server", "run": true },
    "test": { "cmd": "npm run test:e2e" },
    "build": { "cmd": "npm run build" },
    "preview": { "cmd": "npm run preview", "label": "Built site" }
  },
  "env": { "HU_FIXED_TIME": "2026-10-01T09:00:00Z" },
  "deps": { "kind": "npm", "lock": "package-lock.json", "mode": "own" },
  "build": [".vite-cache", "dist"],
  "open": ["README.md", "src/main.js"],
  "hidden": [".git"],
  "panels": ["terminal", "server", "ports", "problems", "results"],
  "diagnostics": [],
  "autosave": true,
  "restartOnReset": false,
  "limits": { "memoryMb": 1536, "cpus": 2, "pids": 512 }
}
