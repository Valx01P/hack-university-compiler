# Trailhead's mock services. They run inside the workspace on port 4000
# (npm run mock), and the app reaches them through MOCK_API_URL.
@mock = http://localhost:4000

### Every route, its latency, and any active overrides
GET {{mock}}/

### Stock for one product (600 ms)
GET {{mock}}/inventory/ridge-2p-tent

### Unknown products are 404
GET {{mock}}/inventory/no-such-product

### Review summary (900 ms)
GET {{mock}}/reviews/ridge-2p-tent/summary

### Recent reviews, newest first (900 ms)
GET {{mock}}/reviews/ridge-2p-tent

### Nobody has reviewed the kettle yet, so the reviews service answers 404
GET {{mock}}/reviews/camp-kettle-1l

### Shipping estimate in days (300 ms)
GET {{mock}}/shipping/titan-pot-set

### Three related products (700 ms)
GET {{mock}}/recommendations/ridge-2p-tent

### Help center entries (400 ms)
GET {{mock}}/faq

### Current deals (500 ms)
GET {{mock}}/deals

### The team (300 ms)
GET {{mock}}/team

### A product photo from the image CDN (no delay)
GET {{mock}}/cdn/products/ridge-2p-tent.webp

### A category banner from the image CDN
GET {{mock}}/cdn/banners/tents.webp

### A brand logo from the image CDN
GET {{mock}}/cdn/brands/cairn-works.png

### Make the next call to /faq fail with a 500
POST {{mock}}/__fail?path=/faq&times=1&status=500

### Make the next two inventory calls, for any product, fail with a 503
POST {{mock}}/__fail?path=/inventory/*&times=2&status=503

### Slow the reviews service down to 3 seconds
POST {{mock}}/__latency?path=/reviews/*&ms=3000

### Remove every delay
POST {{mock}}/__latency?ms=0

### The request log, one JSON object per line (path, status, start and end in ms)
GET {{mock}}/__log

### Restore the data, latencies, failures, and log
POST {{mock}}/__reset
