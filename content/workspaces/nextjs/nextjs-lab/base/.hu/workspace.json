{
  "template": "nextjs-lab",
  "processes": [
    { "name": "mock", "command": "npm run mock", "port": 4000, "internal": true, "readyPath": "/" },
    { "name": "dev", "command": "npm run dev", "portEnv": "PORT", "readyPath": "/" }
  ],
  "ports": [
    { "env": "PORT", "default": 3000, "label": "Preview (next dev)", "preview": true },
    { "env": "PROD_PORT", "default": 3001, "label": "Production (next start, after npm run build)" },
    { "port": 4000, "label": "Mock services", "internal": true }
  ],
  "database": null,
  "previewPath": "/"
}
