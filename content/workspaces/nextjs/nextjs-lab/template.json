{
  "id": "nextjs-lab",
  "course": "nextjs",
  "title": "Trailhead Lab",
  "image": "web",
  "storage": "host",
  "profile": "standard",
  "layout": "preview-first",
  "start": "open",
  "examples": "shared",
  "ports": [
    { "env": "PORT", "label": "Preview", "readyPath": "/", "preview": true },
    { "env": "PROD_PORT", "label": "Production build", "readyPath": "/" }
  ],
  "tasks": {
    "mock": { "cmd": "npm run mock", "label": "Mock services", "run": true },
    "dev": { "cmd": "npm run dev", "label": "Server", "run": true },
    "build": { "cmd": "npm run build", "label": "Build" },
    "start": { "cmd": "npm run start", "label": "Production server" },
    "test": { "cmd": "npm test" },
    "typecheck": { "cmd": "npm run typecheck" },
    "lint": { "cmd": "npm run lint" },
    "routes": { "cmd": "npm run routes" }
  },
  "env": { "NEXT_TELEMETRY_DISABLED": "1", "TZ": "UTC", "HU_FIXED_TIME": "2026-10-01T09:00:00Z" },
  "deps": { "kind": "npm", "lock": "package-lock.json", "mode": "shared" },
  "build": [".next"],
  "open": ["README.md", "app/page.tsx"],
  "requests": "requests.http",
  "readonly": ["README.md"],
  "hidden": [".git", ".hu"],
  "panels": ["terminal", "server", "ports", "api", "problems", "results"],
  "diagnostics": [{ "on": "save", "cmd": ["npx", "tsc", "--noEmit", "--pretty", "false"], "parser": "tsc" }],
  "autosave": true,
  "restartOnReset": false,
  "limits": { "memoryMb": 2048, "cpus": 2, "pids": 512 }
}
