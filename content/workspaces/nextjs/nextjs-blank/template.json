{
  "id": "nextjs-blank",
  "course": "nextjs",
  "title": "Next.js playground",
  "description": "A fresh Next.js 16 app as create-next-app sets one up, with TypeScript, the App Router, and Tailwind CSS, to try anything from the course.",
  "image": "web",
  "storage": "host",
  "profile": "standard",
  "layout": "preview-first",
  "start": "open",
  "examples": "shared",
  "ports": [{ "env": "PORT", "label": "Preview", "readyPath": "/", "preview": true }],
  "tasks": {
    "dev": { "cmd": "npm run dev", "label": "Server", "run": true },
    "build": { "cmd": "npm run build", "label": "Build" },
    "start": { "cmd": "npm run start", "label": "Production server" },
    "lint": { "cmd": "npm run lint" }
  },
  "env": { "NEXT_TELEMETRY_DISABLED": "1", "TZ": "UTC", "HU_FIXED_TIME": "2026-10-01T09:00:00Z" },
  "deps": { "kind": "npm", "lock": "package-lock.json", "mode": "own" },
  "build": [".next"],
  "open": ["app/page.tsx"],
  "readonly": [],
  "hidden": [".git"],
  "panels": ["terminal", "server", "ports", "problems"],
  "diagnostics": [{ "on": "save", "cmd": ["npx", "tsc", "--noEmit", "--pretty", "false"], "parser": "tsc" }],
  "autosave": true,
  "restartOnReset": false,
  "limits": { "memoryMb": 2048, "cpus": 2, "pids": 512 }
}
