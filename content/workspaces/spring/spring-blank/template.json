{
  "id": "spring-blank",
  "course": "spring",
  "title": "Spring Boot playground",
  "description": "A blank Spring Boot 4.1 project on Java 25 with one endpoint and one table, to try anything from the course.",
  "image": "java",
  "storage": "host",
  "profile": "standard",
  "layout": "ide",
  "start": "run",
  "examples": "shared",
  "services": {
    "postgres": {"build": ["./mvnw", "-o", "-q", "spring-boot:run", "-Dspring-boot.run.jvmArguments=-Dspring.devtools.restart.enabled=false -Dspring.context.exit=onRefresh"], "databases": ["dev"]}
  },
  "ports": [{"env": "PORT", "label": "API", "readyPath": "/actuator/health"}],
  "tasks": {
    "dev": {"cmd": "./mvnw -o spring-boot:run", "label": "Server", "run": true},
    "test": {"cmd": "./mvnw -o test"},
    "package": {"cmd": "./mvnw -o -DskipTests package", "label": "Package"}
  },
  "env": {"HU_FIXED_TIME": "2026-10-01T09:00:00Z"},
  "deps": {"kind": "maven", "lock": "pom.xml", "mode": "shared"},
  "build": ["target"],
  "open": ["README.md", "src/main/java/dev/hackuniversity/playground/hello/HelloController.java"],
  "requests": "requests.http",
  "hidden": [".git"],
  "panels": ["terminal", "server", "ports", "api", "database", "problems", "results"],
  "diagnostics": [{"on": "save", "cmd": ["./mvnw", "-o", "-q", "compile"], "parser": "javac"}],
  "autosave": true,
  "restartOnReset": true,
  "limits": {"memoryMb": 1536, "cpus": 2, "pids": 512}
}
