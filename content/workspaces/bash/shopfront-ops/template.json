{
  "id": "shopfront-ops",
  "course": "bash",
  "title": "Shopfront ops repo (scripts, cron, deploys and a JSON API)",
  "image": "bash",
  "storage": "volume",
  "profile": "sysadmin",
  "layout": "ide",
  "start": "open",
  "volumes": ["/srv", "/var/spool/cron/crontabs"],
  "seed": "seed.sh",
  "cwd": "/home/learner/shopfront-ops",
  "ports": [],
  "tasks": {
    "dev": { "cmd": "cd shopfront-ops && bin/taskapictl start && exec bin/taskapictl logs -f", "label": "taskapi" },
    "test": { "cmd": "cd shopfront-ops && make test" },
    "lint": { "cmd": "cd shopfront-ops && make lint" },
    "report": { "cmd": "cd shopfront-ops && make report" },
    "seed": { "cmd": "cd shopfront-ops && bin/taskapictl reset" }
  },
  "env": { "HU_FIXED_TIME": "2026-10-19T09:00:00Z" },
  "open": ["shopfront-ops/README.md", "shopfront-ops/bin/taskapictl"],
  "panels": ["terminal", "server", "problems", "results"],
  "diagnostics": [
    {
      "on": "save",
      "cmd": ["bash", "-c", "cd shopfront-ops && shopt -s nullglob && shellcheck -f gcc -- bin/taskapictl bin/*.sh bin/lib/*.sh bin/sim/* stubs/* tests/helpers/stub.bash tests/*.bats"],
      "parser": "shellcheck"
    }
  ],
  "autosave": true,
  "restartOnReset": false,
  "limits": { "memoryMb": 512, "cpus": 1, "pids": 256 }
}
