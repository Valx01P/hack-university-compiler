# Settings for the scripts in bin/. Copy this file to .env and fill it in:
#   cp .env.example .env && chmod 600 .env
# .env holds a token, so it is never committed (see .gitignore).

# The port taskapi listens on, on 127.0.0.1.
API_PORT=8080

# Where scripts reach taskapi.
API_URL=http://127.0.0.1:8080

# A bearer token for the API's write routes. Ask an admin for yours.
API_TOKEN=change-me

# Where taskapi and the scripts write logs, relative to the repo.
LOG_DIR=logs

# Where bin/backup.sh writes archives, relative to the repo.
BACKUP_DIR=backups

# How many archives bin/prune-backups.sh keeps.
KEEP_BACKUPS=5
