#!/usr/bin/env bash
# A fake free for tests and examples: a machine with STUB_MEM_TOTAL_MB of
# memory (default 512), of which STUB_MEM_AVAILABLE_MB are available
# (default 300). Prints megabytes whatever the options.
set -euo pipefail

total=${STUB_MEM_TOTAL_MB:-512}
available=${STUB_MEM_AVAILABLE_MB:-300}
used=$((total - available))
printf '%15s %11s %11s %11s %11s %11s\n' total used free shared buff/cache available
printf '%-6s %8d %11d %11d %11d %11d %11d\n' Mem: "$total" "$used" "$((available / 2))" 1 "$((available / 2))" "$available"
printf '%-6s %8d %11d %11d\n' Swap: 0 0 0
