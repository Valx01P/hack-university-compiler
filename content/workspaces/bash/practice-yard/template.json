{
  "id": "practice-yard",
  "course": "bash",
  "title": "Practice yard (a messy home folder)",
  "image": "bash",
  "storage": "volume",
  "profile": "sysadmin",
  "layout": "ide",
  "start": "open",
  "volumes": ["/srv", "/var/spool/cron/crontabs"],
  "seed": "seed.sh",
  "seedEnv": { "HU_INSTANCE": "workspace" },
  "cwd": "/home/learner",
  "ports": [],
  "tasks": {},
  "env": { "HU_FIXED_TIME": "2026-10-19T09:00:00Z" },
  "open": ["answers.txt"],
  "panels": ["terminal", "problems", "results"],
  "diagnostics": [
    {
      "on": "save",
      "cmd": ["bash", "-c", "shopt -s nullglob; files=(bin/* projects/scripts/*.sh *.sh); (( ${#files[@]} == 0 )) || shellcheck -f gcc -S warning -- \"${files[@]}\""],
      "parser": "shellcheck"
    }
  ],
  "autosave": true,
  "restartOnReset": false,
  "limits": { "memoryMb": 512, "cpus": 1, "pids": 256 }
}
