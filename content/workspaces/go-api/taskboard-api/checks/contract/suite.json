{
  "version": 1,
  "image": "go",
  "db": "clone",
  "copy": { "exclude": ["bin", "data"], "git": false },
  "deadlineMs": 60000,
  "server": {
    "task": "dev",
    "port": "PORT",
    "env": { "HU_FIXED_TIME": "2026-10-01T09:00:00Z", "CORS_ORIGINS": "http://localhost:20013", "AUTH_MODE": "session" },
    "ready": { "path": "/readyz", "timeoutMs": 30000 }
  },
  "steps": [
    { "id": "core", "kind": "http-file", "file": "contracts/taskboard/acceptance.http", "from": "content", "openapi": "contracts/taskboard/openapi.yaml" }
  ],
  "acceptance": {
    "core": "The Taskboard contract's core tier passes (acceptance.http), and every response validates against openapi.yaml"
  }
}
