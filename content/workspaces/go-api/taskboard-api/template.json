{
  "id": "taskboard-api",
  "course": "go-api",
  "title": "Taskboard API",
  "description": "A team task tracker's JSON API in the layered shape most Go services have: handlers, services, and repositories on PostgreSQL with migrations.",
  "image": "go",
  "storage": "host",
  "profile": "standard",
  "layout": "ide",
  "start": "run",
  "services": { "postgres": { "build": ["make", "migrate-up", "seed"], "databases": ["dev", "test"] } },
  "ports": [
    { "env": "PORT", "label": "API", "readyPath": "/healthz" },
    { "env": "ADMIN_PORT", "label": "Admin (metrics, pprof)", "readyPath": "/debug/vars" }
  ],
  "tasks": {
    "dev": { "cmd": "make run", "label": "Server", "run": true },
    "test": { "cmd": "make test" },
    "test-race": { "cmd": "make test-race" },
    "seed": { "cmd": "make db-reset", "label": "Reset and seed the database" },
    "migrate": { "cmd": "make migrate-up" },
    "sqlc": { "cmd": "make sqlc" },
    "lint": { "cmd": "make lint" }
  },
  "env": {
    "APP_ENV": "development",
    "LOG_LEVEL": "info",
    "MIGRATE_ON_START": "true",
    "HU_FIXED_TIME": "2026-10-01T09:00:00Z",
    "GOOSE_DRIVER": "postgres",
    "GOOSE_DBSTRING": "${DATABASE_URL}",
    "GOOSE_MIGRATION_DIR": "db/migrations"
  },
  "deps": { "kind": "go", "lock": "go.sum", "mode": "shared" },
  "open": ["README.md", "internal/api/routes.go"],
  "requests": "requests.http",
  "readonly": ["README.md", "internal/store/sqlcdb/**", "internal/domain/priority_string.go"],
  "generated": {
    "internal/store/sqlcdb/**": "Generated by sqlc. Edit db/queries and run sqlc generate.",
    "internal/domain/priority_string.go": "Generated by stringer. Edit internal/domain/task.go and run go generate ./..."
  },
  "hidden": [".git"],
  "panels": ["terminal", "server", "ports", "api", "database", "problems", "results"],
  "diagnostics": [{ "on": "save", "cmd": ["go", "vet", "./..."], "parser": "go" }],
  "autosave": true,
  "restartOnReset": true,
  "limits": { "memoryMb": 2048, "cpus": 2, "pids": 1024 }
}
