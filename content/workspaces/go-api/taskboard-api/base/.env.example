# Every setting the API reads, with safe values for development. Copy this file to
# .env (which git ignores, since it may hold secrets) and change what you need: the
# Makefile loads .env for every target, and what .env sets wins over the environment.
# In Hack University the workspace already sets PORT, ADMIN_PORT, DATABASE_URL, and
# HU_FIXED_TIME, so they wait here as comments: uncomment them on your own machine.

# The API's port, and the admin server's (metrics and pprof, on 127.0.0.1 only; 0 turns it off).
# PORT=8080
# ADMIN_PORT=6060

# DATABASE_URL=postgres://taskboard:taskboard@localhost:5432/taskboard?sslmode=disable

# development (adds X-Query-Count), test, or production (demands a real TOKEN_SECRET).
APP_ENV=development
LOG_LEVEL=info

# Signs JWTs in AUTH_MODE=jwt. Production needs 32 bytes or more: openssl rand -hex 32
TOKEN_SECRET=
AUTH_MODE=session
BCRYPT_COST=10

MIGRATE_ON_START=true
SLOW_QUERY_MS=200

# Origins a browser page may call the API from, with cookies: comma-separated, exact.
CORS_ORIGINS=http://localhost:5173
# The reverse proxy whose X-Forwarded-For header is believed, if there is one.
TRUSTED_PROXY=

UPLOAD_DIR=data/uploads
SHUTDOWN_TIMEOUT=10s

# Stops the clock, so times in responses and tests never change.
# HU_FIXED_TIME=2026-10-01T09:00:00Z
