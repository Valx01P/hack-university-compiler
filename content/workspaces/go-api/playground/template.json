{
  "id": "playground",
  "course": "go-api",
  "title": "Go API playground",
  "description": "A free-play Go module with its own PostgreSQL database, for trying a handler, a query, a goroutine, or a test.",
  "image": "go",
  "storage": "host",
  "profile": "standard",
  "layout": "ide",
  "start": "run",
  "services": { "postgres": { "build": [], "databases": ["dev"] } },
  "ports": [{ "env": "PORT", "label": "Server", "readyPath": "/hello" }],
  "tasks": {
    "dev": { "cmd": "go run .", "label": "Server", "run": true },
    "test": { "cmd": "go test ./..." },
    "scratch": { "cmd": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f scratch.sql", "label": "Load scratch.sql" }
  },
  "env": { "HU_FIXED_TIME": "2026-10-01T09:00:00Z" },
  "deps": { "kind": "go", "lock": "go.sum", "mode": "shared" },
  "open": ["README.md", "main.go"],
  "requests": "requests.http",
  "hidden": [".git"],
  "panels": ["terminal", "server", "ports", "api", "database", "problems"],
  "diagnostics": [{ "on": "save", "cmd": ["go", "vet", "./..."], "parser": "go" }],
  "autosave": true,
  "restartOnReset": false,
  "limits": { "memoryMb": 2048, "cpus": 2, "pids": 1024 }
}
