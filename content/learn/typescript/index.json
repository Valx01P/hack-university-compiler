{
  "language": "typescript",
  "title": "Learn TypeScript",
  "description": "Learn TypeScript 7 on Node 26 with no build step, from your first type annotation through unions and narrowing, generics, classes, async code, and validating JSON with zod. Every part shows worked examples first, then you solve a practice that the type checker and the tests both check.",
  "sections": [
    {
      "title": "TypeScript on Node",
      "lessons": [
        "hello-typescript",
        "basic-types",
        "arrays-tuples",
        "functions"
      ]
    },
    {
      "title": "Object Types",
      "lessons": [
        "object-types",
        "literal-types",
        "interfaces"
      ]
    },
    {
      "title": "Unions and Narrowing",
      "lessons": [
        "unions-narrowing",
        "unknown-any-never",
        "type-guards",
        "discriminated-unions",
        "enums-vs-unions"
      ]
    },
    {
      "title": "Generics",
      "lessons": [
        "generic-functions",
        "generic-constraints",
        "generic-types"
      ]
    },
    {
      "title": "Type Transformations",
      "lessons": [
        "utility-types",
        "mapped-types",
        "conditional-types",
        "template-literal-types",
        "branded-types"
      ]
    },
    {
      "title": "Classes",
      "lessons": [
        "classes",
        "implements-abstract"
      ]
    },
    {
      "title": "Async and Errors",
      "lessons": [
        "typed-promises",
        "error-handling",
        "result-types"
      ]
    },
    {
      "title": "Data at the Edges",
      "lessons": [
        "typing-json",
        "zod-basics",
        "zod-at-the-edges",
        "typing-api-responses"
      ]
    }
  ]
}
