{
  "language": "sql",
  "title": "Learn SQL",
  "description": "PostgreSQL from your first SELECT to joins, window functions, table design, and recursive queries. Every lesson runs on its own small tables in a real PostgreSQL 18.",
  "sections": [
    {
      "title": "Basics",
      "lessons": [
        "select-values",
        "data-types",
        "first-table",
        "select-columns"
      ]
    },
    {
      "title": "Filtering and Sorting",
      "lessons": [
        "where",
        "in-between-like",
        "sorting",
        "null"
      ]
    },
    {
      "title": "Expressions and Functions",
      "lessons": [
        "math",
        "case",
        "series",
        "strings",
        "patterns",
        "dates",
        "functions"
      ]
    },
    {
      "title": "Summarizing Data",
      "lessons": [
        "aggregates",
        "group-by",
        "set-operations"
      ]
    },
    {
      "title": "Joining Tables",
      "lessons": [
        "joins",
        "outer-joins",
        "more-joins",
        "subqueries",
        "ctes"
      ]
    },
    {
      "title": "Arrays, JSON, and Rows",
      "lessons": [
        "arrays",
        "jsonb",
        "row-values",
        "bitwise"
      ]
    },
    {
      "title": "Window Functions",
      "lessons": [
        "window-functions",
        "running-totals",
        "lag-lead"
      ]
    },
    {
      "title": "Designing Tables",
      "lessons": [
        "create-tables",
        "constraints",
        "update-delete",
        "foreign-keys",
        "upsert",
        "alter-drop"
      ]
    },
    {
      "title": "Reliable Data",
      "lessons": [
        "transactions",
        "error-handling",
        "views-indexes",
        "normalization"
      ]
    },
    {
      "title": "Recursive Queries",
      "lessons": [
        "recursive-ctes",
        "linked-rows",
        "trees",
        "graphs"
      ]
    }
  ]
}
