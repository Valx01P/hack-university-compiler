{
  "language": "go",
  "title": "Learn Go",
  "description": "Learn Go 1.16 one small step at a time, from your first fmt.Println to slices, maps, structs, interfaces, JSON, goroutines, channels, and classic algorithms. Every step shows a worked example, then gives you a practice problem with the same shape.",
  "sections": [
    {
      "title": "Basics",
      "lessons": [
        "print",
        "variables",
        "multiple-assignment",
        "formatted-output",
        "math-operators",
        "infinity-and-nil"
      ]
    },
    {
      "title": "Control Flow",
      "lessons": [
        "if-statements",
        "if-else",
        "switch",
        "ternary",
        "for-loops",
        "while-loops"
      ]
    },
    {
      "title": "Arrays and Slices",
      "lessons": [
        "arrays-and-slices",
        "looping-slices",
        "slice-patterns",
        "two-d-arrays"
      ]
    },
    {
      "title": "Strings",
      "lessons": [
        "strings",
        "string-iteration"
      ]
    },
    {
      "title": "Functions",
      "lessons": [
        "functions",
        "closures",
        "builtin-functions"
      ]
    },
    {
      "title": "Memory",
      "lessons": [
        "pointers",
        "slice-internals"
      ]
    },
    {
      "title": "Collections",
      "lessons": [
        "maps",
        "sets",
        "tuples"
      ]
    },
    {
      "title": "Object-Oriented Programming",
      "lessons": [
        "structs-methods",
        "interfaces"
      ]
    },
    {
      "title": "Standard Library",
      "lessons": [
        "strconv",
        "sorting",
        "time-and-json"
      ]
    },
    {
      "title": "Input",
      "lessons": [
        "user-input"
      ]
    },
    {
      "title": "Bits and Errors",
      "lessons": [
        "bitwise",
        "errors",
        "defer-panic-recover"
      ]
    },
    {
      "title": "More Object-Oriented Programming",
      "lessons": [
        "embedding"
      ]
    },
    {
      "title": "Concurrency",
      "lessons": [
        "goroutines",
        "channels",
        "select"
      ]
    },
    {
      "title": "Advanced: Data Structures and Algorithms",
      "lessons": [
        "recursion-dfs",
        "bfs",
        "linked-lists",
        "trees",
        "graphs"
      ]
    }
  ]
}
