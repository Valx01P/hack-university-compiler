{
  "language": "bash",
  "title": "Learn Bash",
  "description": "Write the Bash scripts engineers use every day, from redirection and pipes through grep, sed, and awk, variables, loops, and functions, strict mode, and JSON with jq. Every part shows worked examples first, then you write a script that the checks run on real files.",
  "sections": [
    {
      "title": "Streams and Pipes",
      "lessons": [
        "redirection",
        "exit-codes",
        "pipes-and-filters",
        "sort-uniq-cut"
      ]
    },
    {
      "title": "Text Processing",
      "lessons": [
        "grep",
        "sed",
        "awk"
      ]
    },
    {
      "title": "Bash Scripting",
      "lessons": [
        "variables-and-quoting",
        "parameter-expansion",
        "command-substitution-and-math",
        "read-and-printf",
        "conditionals",
        "loops",
        "functions"
      ]
    },
    {
      "title": "Data in Bash",
      "lessons": [
        "arrays",
        "heredocs"
      ]
    },
    {
      "title": "Robust Scripts",
      "lessons": [
        "strict-mode",
        "arguments-and-getopts",
        "traps-and-temp-files"
      ]
    },
    {
      "title": "Web APIs from the Terminal",
      "lessons": [
        "jq"
      ]
    },
    {
      "title": "Automation and DevOps",
      "lessons": [
        "log-analysis"
      ]
    }
  ]
}
