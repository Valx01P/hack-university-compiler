{
  "name": "hack-university-compiler",
  "version": "0.1.0",
  "private": true,
  "description": "The Hack University online compiler, running entirely on localhost with a local Piston sandbox.",
  "scripts": {
    "up": "node scripts/up.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "setup": "npm run piston:up && npm run piston:install && npm run search:setup",
    "piston:up": "docker compose up -d",
    "piston:down": "docker compose down",
    "piston:install": "node scripts/setup-piston.mjs",
    "piston:status": "node scripts/setup-piston.mjs --list",
    "search:setup": "node scripts/setup-search.mjs",
    "lessons:verify": "node scripts/verify-lessons.mjs",
    "challenges:verify": "node scripts/verify-challenges.mjs",
    "reference:verify": "node scripts/verify-reference.mjs",
    "snippets:verify": "node scripts/verify-snippets.mjs",
    "sql:try": "node scripts/try-sql.mjs",
    "runner": "node runner/main.ts",
    "runner:test": "node --test \"runner/**/*.test.ts\"",
    "images": "node runner/images.ts build",
    "images:status": "node runner/images.ts status",
    "security:verify": "node scripts/verify-security.mjs"
  },
  "engines": {
    "node": ">=24.12"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@electric-sql/pglite": "0.5.8",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@gsap/react": "2.1.2",
    "@lezer/highlight": "^1.2.3",
    "@replit/codemirror-indentation-markers": "^6.5.3",
    "gsap": "3.15.0",
    "lucide-react": "^1.20.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "simple-icons": "^16.23.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4.3.0",
    "typescript": "^5"
  }
}
