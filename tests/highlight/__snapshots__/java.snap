    «k|public» «k|String» «f|toString»() {
        «k|return» «s|"Main"»;
    }

    «f|@SuppressWarnings»(«s|"unchecked"»)
    «k|static» <T> List<T> «f|listOf»(T... items) {
        «k|return» «k|new» ArrayList<>(Arrays.«f|asList»(items));
    }

    «k|public» @«k|interface» Marker {}

    «k|public» «k|static» «k|void» «f|main»(«k|String»[] args) {
        Scanner in = «k|new» «f|Scanner»(«k|System».in);
