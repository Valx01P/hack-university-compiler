# tokenize(sample, "toml")
# «k|…» keyword, «s|…» string, «e|…» escape, «n|…» number, «c|…» comment, «f|…» fn, «d|…» directive, anything else plain
«c|# pyproject»
«k|[project]»
«f|name» = «s|"notes-api"»
«f|version» = «s|"0.1.0"»
«f|dependencies» = [«s|"fastapi==0.148.0"»]

«k|[[tool.mypy.overrides]]»
«f|strict» = «k|true» «c|# always»
«f|released» = «n|2026-10-19»

# stripComments(sample, "toml")
[project]
name = "notes-api"
version = "0.1.0"
dependencies = ["fastapi==0.148.0"]

[[tool.mypy.overrides]]
strict = true
released = 2026-10-19

