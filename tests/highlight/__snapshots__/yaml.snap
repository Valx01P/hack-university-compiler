# tokenize(sample, "yaml")
# «k|…» keyword, «s|…» string, «e|…» escape, «n|…» number, «c|…» comment, «f|…» fn, «d|…» directive, anything else plain
«c|# A compose file for the playground»
«f|services»:
  «f|db»:
    «f|image»: «s|"postgres:18.6-alpine"»
    «f|ports»:
      «k|- »«n|5432»
    «f|environment»:
      «f|POSTGRES_PASSWORD»: «s|'secret # not a comment'»
      «f|ENABLED»: «k|true» «c|# this is one»
    «f|anchors»: «k|&defaults»
      «f|retries»: «n|3»
«k|---»
«f|list»:
  «k|- »«f|name»: Ada
    «f|admin»: «k|yes»
  «k|- »«k|*defaults»

# stripComments(sample, "yaml")
services:
  db:
    image: "postgres:18.6-alpine"
    ports:
      - 5432
    environment:
      POSTGRES_PASSWORD: 'secret # not a comment'
      ENABLED: true
    anchors: &defaults
      retries: 3
---
list:
  - name: Ada
    admin: yes
  - *defaults

