# tokenize(sample, "css")
# «k|…» keyword, «s|…» string, «e|…» escape, «n|…» number, «c|…» comment, «f|…» fn, «d|…» directive, anything else plain
«c|/* The card, on every screen */»
:root {
  «f|--accent»: «n|#f8efb6»;
}
.card:hover,
a:focus-visible {
  «f|color»: «f|var»(--accent);
  «f|margin»: «n|0» auto «n|1.5rem»;
  «f|width»: «f|calc»(«n|100%» - «n|2rem») «k|!important»;
  «f|font-family»: «s|"Inter"», sans-serif;
}
«k|@media» (min-width: «n|48rem») {
  .card { «f|padding»: «n|24px»; }
}

# stripComments(sample, "css")
:root {
  --accent: #f8efb6;
}
.card:hover,
a:focus-visible {
  color: var(--accent);
  margin: 0 auto 1.5rem;
  width: calc(100% - 2rem) !important;
  font-family: "Inter", sans-serif;
}
@media (min-width: 48rem) {
  .card { padding: 24px; }
}

