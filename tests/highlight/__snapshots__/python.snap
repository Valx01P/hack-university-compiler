# stripComments(sample, "python")
#!/usr/bin/env python3
import math
from collections import Counter, defaultdict  # noqa: F401
from dataclasses import dataclass


@dataclass(frozen=True)
class Point:
    x: int
    y: int = 0

    @property
    def norm(self) -> float:
        return math.hypot(self.x, self.y)

    @functools.lru_cache(maxsize=None)
    def scaled(self, k):
        return Point(self.x * k, self.y * k)


def greet(name="world"):
    """Docstring with "quotes" and \t a tab escape."""
    print(f"Hello, {name}!\n")
    print('single \'quoted\' text', "\x41\u00e9\N{BULLET}\101")
    print(r"raw \n stays", rb"\d+", Rb'\w', br"\s")
    return None


values = [1, 2_000, 3.14, 1e10, 0x1F, 0b1010]
product = a @ b
total = sum(values)  # type: ignore
if total > 10 and not False:
    pass
counts = Counter("hello")
print(counts.most_common(1), len(values), "#not a comment")
square = lambda x: x ** 2
match total:
    case 0:
        print("zero")
    case _:
        print("other")

