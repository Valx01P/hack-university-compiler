# stripComments(sample, "javascript")
#!/usr/bin/env node
"use strict";
const fs = require("fs");
import { readFile } from "node:fs/promises";

function add(a, b) {
  return a + b;
}

class Counter {
  static #count = 0;
  get value() { return Counter.#count; }
  set value(v) { Counter.#count = v; }
  increment() {
    Counter.#count++;
    return this;
  }
}

const name = 'Ada';
const greeting = `Hello, ${name}!\n`;
const raw = String.raw`C:\temp\new`;
const re = /ab+c/gi;
const big = 9007199254740993n;
const nums = [1, 2.5, 1e3, 0xff, 1_000];
let maybe = null ?? undefined;
console.log(add(1, 2), "tab\tand\u00e9\x41", greeting, raw);
async function main() {
  const text = await readFile("data.txt", "utf8");
  for (const line of text.split("\n")) {
    if (line.startsWith("#")) continue;
  }
}
map.get(key); obj.set(1, 2);

