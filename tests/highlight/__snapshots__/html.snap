# tokenize(sample, "html")
# «k|…» keyword, «s|…» string, «e|…» escape, «n|…» number, «c|…» comment, «f|…» fn, «d|…» directive, anything else plain
«k|<!doctype html>»
<«k|html» «f|lang»=«s|"en"»>
  «c|<!-- the page's one heading -->»
  <«k|body» «f|class»=«s|'page'» «f|data-theme»=«s|"light"»>
    <«k|h1» «f|id»=«s|title»>Tom «e|&amp;» Jerry's "show"</«k|h1»>
    <«k|input» «f|disabled» «f|value»=«s|"it's"»>
    <«k|style»>
      h1 { «f|color»: red; }
    </«k|style»>
    <«k|script» «f|type»=«s|"module"»>
      «k|const» n = «n|1»; «c|// a comment in the script»
      document.title = «s|`n is ${n}`»;
    </«k|script»>
  </«k|body»>
</«k|html»>

# stripComments(sample, "html")
<!doctype html>
<html lang="en">
  <body class='page' data-theme="light">
    <h1 id=title>Tom &amp; Jerry's "show"</h1>
    <input disabled value="it's">
    <style>
      h1 { color: red; }
    </style>
    <script type="module">
      const n = 1;
      document.title = `n is ${n}`;
    </script>
  </body>
</html>

