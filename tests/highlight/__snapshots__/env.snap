# tokenize(sample, "env")
# «k|…» keyword, «s|…» string, «e|…» escape, «n|…» number, «c|…» comment, «f|…» fn, «d|…» directive, anything else plain
«c|# The playground's settings»
«f|PORT»=8080
«k|export» «f|DATABASE_URL»=«s|"postgres://ws@db:5432/ws"»
«f|GREETING»=«s|'Hello # not a comment'»
«f|HOME_DIR»=«e|${HOME}»/app

# stripComments(sample, "env")
PORT=8080
export DATABASE_URL="postgres://ws@db:5432/ws"
GREETING='Hello # not a comment'
HOME_DIR=${HOME}/app

