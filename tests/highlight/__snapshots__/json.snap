# tokenize(sample, "json")
# «k|…» keyword, «s|…» string, «e|…» escape, «n|…» number, «c|…» comment, «f|…» fn, «d|…» directive, anything else plain
{
  «c|// The course's settings (tsconfig allows comments).»
  «f|"compilerOptions"»: {
    «f|"target"»: «s|"esnext"»,
    «f|"strict"»: «k|true»,
    «f|"types"»: [«s|"node"»],
    «c|/* a block comment */»
    «f|"paths"»: { «f|"#lib/*"»: [«s|"./src/lib/*"»] },
    «f|"limit"»: «n|-1.5e3»,
    «f|"escaped"»: «s|"tab»«e|\t»«s|here »«e|\"»«s|quoted»«e|\"»«s| é"»,
    «f|"nothing"»: «k|null»
  }
}

# stripComments(sample, "json")
{
  "compilerOptions": {
    "target": "esnext",
    "strict": true,
    "types": ["node"],
    "paths": { "#lib/*": ["./src/lib/*"] },
    "limit": -1.5e3,
    "escaped": "tab\there \"quoted\" é",
    "nothing": null
  }
}

