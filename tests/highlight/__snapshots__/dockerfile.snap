# stripComments(sample, "dockerfile")
# syntax=docker/dockerfile:1
FROM node:26.12.0-trixie-slim AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci --ignore-scripts && echo "done"
ENV PORT=${PORT:-8080}
EXPOSE 8080
CMD ["node", "src/main.ts"]

