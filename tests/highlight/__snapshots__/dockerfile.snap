# «k|…» keyword, «s|…» string, «e|…» escape, «n|…» number, «c|…» comment, «f|…» fn, «d|…» directive, anything else plain
«d|# syntax=docker/dockerfile:1»
«c|# Build the app»
«k|FROM» node:«n|26.12.0»-trixie-slim «k|AS» build
«k|WORKDIR» /app
«k|COPY» package*.json ./
«k|RUN» npm ci --ignore-scripts && echo «s|"done"»
«k|ENV» PORT=«e|${PORT:-8080}»
