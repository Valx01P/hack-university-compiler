# tokenize(sample, "http")
# «k|…» keyword, «s|…» string, «e|…» escape, «n|…» number, «c|…» comment, «f|…» fn, «d|…» directive, anything else plain
«k|@host» = http://localhost:«e|{{$dotenv PORT}}»

«d|### Log in»
«d|# @name login»
«k|POST» «e|{{host}}»/v1/auth/login «k|HTTP/1.1»
«f|Content-Type»: application/json

{«f|"email"»: «s|"ada@example.com"», «f|"remember"»: «k|true», «f|"days"»: «n|30»}

«d|### Who am I»
«c|// a plain comment»
«k|GET» «e|{{host}}»/v1/me
«f|Authorization»: Bearer «e|{{login.response.body.$.token}}»

# stripComments(sample, "http")
@host = http://localhost:{{$dotenv PORT}}

### Log in
# @name login
POST {{host}}/v1/auth/login HTTP/1.1
Content-Type: application/json

{"email": "ada@example.com", "remember": true, "days": 30}

### Who am I
GET {{host}}/v1/me
Authorization: Bearer {{login.response.body.$.token}}

