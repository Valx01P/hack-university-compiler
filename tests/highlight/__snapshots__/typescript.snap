# tokenize(sample, "typescript")
# «k|…» keyword, «s|…» string, «e|…» escape, «n|…» number, «c|…» comment, «f|…» fn, «d|…» directive, anything else plain
#!/usr/bin/env node
// @ts-nocheck
/// <reference types="node" />
import { readFile } from "node:fs/promises";
import type { Server } from "node:http";

// eslint-disable-next-line @typescript-eslint/no-explicit-any
type Json = string | number | boolean | null | Json[] | { [key: string]: Json };

interface User {
  readonly id: number;
  name: string;
  email?: string;
  greet(other: User): string;
}

enum Color { Red = "RED", Green = "GREEN" }

abstract class Shape {
  abstract area(): number;
  describe(): string {
    return `${this.constructor.name} with area ${this.area().toFixed(2)}`;
  }
}

class Circle extends Shape implements Comparable<Circle> {
  static readonly PI = 3.14159;
  #secret = 0;
  constructor(private readonly radius: number) {
    super();
  }
  override area(): number {
    return Circle.PI * this.radius ** 2;
  }
  compareTo(other: Circle): number {
    return this.radius - other.radius;
  }
}

@Component({ selector: "app-root" })
class AppComponent {
  @Input() title = "";
  @HostListener.bind("click") onClick() {}
}

function isString(x: unknown): x is string {
  return typeof x === "string";
}

function assertDefined<T>(value: T | undefined): asserts value is T {
  if (value === undefined) throw new Error("missing\tvalue");
}

const point = { x: 1, y: 2, show() { return this.x; } } as const satisfies Record<string, unknown>;
const keys: Array<keyof typeof point> = Object.keys(point) as (keyof typeof point)[];
type Mapped<T> = { readonly [K in keyof T]: T[K] extends infer U ? U : never };
type Path = `/${string}`;
const raw = String.raw`C:\new\table ${point.x}`;
const escaped = "tab\t quote\" unicode\u00e9 \x41 \u{1F600}";
const multi = `line one
line two\n`;
const big = 10n, hex = 0xff, sep = 1_000.5e-3;
const re = /^[a-z]+\/\d+$/i;
const users = new Map<number, User>();
const found = users.get(1)?.name ?? "nobody";
let count: number = 0;
let nothing = undefined, symbolic: symbol, anything: any, obj: object, b: bigint;
for (const [id, user] of users) {
  count += id; // add each id
}
// @ts-expect-error the argument must be a number
isString(42) && console.log(`count: ${count}`);
async function load(path: string): Promise<Json> {
  /* read the file,
     then parse it */
  const text = await readFile(path, "utf8");
  return JSON.parse(text) as Json;
}
declare global {
  interface Window { app: AppComponent }
}
namespace Legacy { export const version = "1"; }
const add = <T extends number>(a: T, b: T): number => a + b;
console.log(add(1, 2), useState<string>(""), found, escaped, raw, big, hex, sep, re);
// TODO: load the users
//       and print their names

