# stripComments(sample, "cpp")
#include <iostream>
#include <vector>
#include <string>
using namespace std;

template <typename T>
T biggest(const vector<T>& xs) {
    T best = xs[0];
    for (const auto& x : xs) {
        if (x > best) best = x;
    }
    return best;
}

int main() {
    string s = "tab\there \"quoted\" \x41\101\u00e9";
    string raw = R"(C:\new\table)";
    auto u8raw = u8R"x(raw with "quotes")x";
    char c = '\n', q = '\'';
    long long big = 1000000LL;
    double d = 3.14e-2;
    vector<int> v = {3, 1, 4};
    cout << biggest(v) << ' ' << s.size() << endl;
    return 0;
}

