# tokenize(sample, "go")
# «k|…» keyword, «s|…» string, «e|…» escape, «n|…» number, «c|…» comment, «f|…» fn, «d|…» directive, anything else plain
«c|// Code generated by hand for the tokenizer snapshots; DO NOT EDIT.»

«c|//go:build linux || darwin»

«c|// Package main is a sample for the tokenizer snapshots.»
«k|package» main

«k|import» (
	«s|"embed"»
	«s|"fmt"»
	«s|"strings"»
)

«c|//go:embed static/*»
«k|var» static embed.FS

«c|//go:generate stringer -type=Color»

«k|type» Point «k|struct» {
	X, Y «k|int» «s|`json:"x"`»
}

«k|func» (p Point) «f|String»() «k|string» {
	«k|return» fmt.«f|Sprintf»(«s|"(%d, %d)"», p.X, p.Y)
}

«k|func» «f|main»() {
	s := «s|"tab»«e|\t»«s|here »«e|\"»«s|quoted»«e|\"»«s| »«e|\x41»«e|\u00e9»«e|\101»«s|"»
	raw := «s|`C:\new\table`»
	r := «s|'x'»
	nl := «s|'»«e|\n»«s|'»
	n := «n|1_000»
	f := «n|2.5e-3»
	m := «k|map»[«k|string»]«k|int»{«s|"a"»: «n|1»}
	fmt.«f|Println»(s, raw, r, nl, n, f, m, strings.«f|ToUpper»(«s|"go"»)) «c|//nolint:errcheck»
	«c|/* a block
	   comment */»
	«c|// TODO: print the point»
	«c|//       with Println»
}

«k|func» «f|ExamplePoint»() {
	fmt.«f|Println»(Point{«n|1», «n|2»})
	«c|// Output: (1, 2)»
}

«k|func» «f|ExampleFields»() {
	«k|for» _, w := «k|range» strings.«f|Fields»(«s|"a b"») {
		fmt.«f|Println»(w)
	}
	«c|// Output:»
	«c|// a»
	«c|// b»
}

# stripComments(sample, "go")
package main

import (
	"embed"
	"fmt"
	"strings"
)

var static embed.FS

type Point struct {
	X, Y int `json:"x"`
}

func (p Point) String() string {
	return fmt.Sprintf("(%d, %d)", p.X, p.Y)
}

func main() {
	s := "tab\there \"quoted\" \x41\u00e9\101"
	raw := `C:\new\table`
	r := 'x'
	nl := '\n'
	n := 1_000
	f := 2.5e-3
	m := map[string]int{"a": 1}
	fmt.Println(s, raw, r, nl, n, f, m, strings.ToUpper("go"))
}

func ExamplePoint() {
	fmt.Println(Point{1, 2})
}

func ExampleFields() {
	for _, w := range strings.Fields("a b") {
		fmt.Println(w)
	}
}

