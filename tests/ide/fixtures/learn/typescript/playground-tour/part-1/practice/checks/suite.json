{
  "version": 1,
  "image": "node",
  "db": "none",
  "copy": {
    "exclude": [
      "node_modules"
    ],
    "git": false
  },
  "deadlineMs": 60000,
  "steps": [
    {
      "id": "typecheck",
      "kind": "cmd",
      "run": [
        "npx",
        "tsc",
        "--noEmit",
        "--pretty",
        "false"
      ],
      "expect": {
        "exit": 0
      },
      "parse": "tsc"
    },
    {
      "id": "start",
      "kind": "cmd",
      "run": [
        "node",
        "src/main.ts"
      ],
      "expect": {
        "exit": 0,
        "stdoutIncludes": "Hello, TypeScript?"
      }
    }
  ],
  "acceptance": {
    "typecheck": "The project type-checks",
    "start": "npm start greets with a question mark"
  },
  "starterFails": [
    "start"
  ]
}