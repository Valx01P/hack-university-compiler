#!/usr/bin/env bash

# Piston's run script for Go, plus GODEBUG=asyncpreemptoff=1: the sandbox can
# run x86_64 under emulation (Rosetta on Apple Silicon), where Go's
# signal-based preemption now and then crashes the compiler or the program.
mv $1 $1.go
#filename=$1.go
filename=*.go
shift
GODEBUG=asyncpreemptoff=1 GOCACHE=$PWD go run $filename "$@"
