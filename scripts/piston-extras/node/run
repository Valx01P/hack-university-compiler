#!/bin/bash

# ES modules (main.mjs) load a resolve hook so their bare imports also find
# the packages installed globally in this runtime. CommonJS finds those
# through lib/node, so only ES modules pay the hook's startup time.
if [[ "$1" == *.mjs ]]; then
    exec node --import="file://$(dirname "$0")/lib/hu-global-imports.mjs" "$@"
fi
node "$@"
