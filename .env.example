# Optional. Copy to .env.local to override.

# Where the local Piston sandbox listens (see docker-compose.yml).
PISTON_URL=http://127.0.0.1:2000/api/v2

# Where the local runner listens (TypeScript and Bash). The CSP names this
# port, so a change needs a rebuild. The server reads the runner's token from
# HU_RUNNER_TOKEN, or else from ~/.hack-university/runner-token.
HU_RUNNER_PORT=3100
